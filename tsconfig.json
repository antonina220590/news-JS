{
    "compilerOptions": {
        "module": "es2015",
        "target": "esnext",
        "moduleResolution": "bundler",
        "outDir": "./dist",
        "noEmit": false,

        "types": ["node"],
        "allowJs": true,

        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "strict": true,
        "jsx": "react-jsx",
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "noUncheckedSideEffectImports": true,
        "moduleDetection": "force",
        "skipLibCheck": true
    }
}
